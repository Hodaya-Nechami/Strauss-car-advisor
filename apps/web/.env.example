# מפתחות API למודלי השפה. העתיקו את הקובץ הזה ל-.env (או ל-.env.local) באותה תיקייה, ומלאו את המפתחות.
# שני הקבצים לא עולים לגיט. לא שולחים מפתחות בצ'אט או במייל.

# --- חינמיים. אפשר אחד, שניים או שלושה. ---
# הבוט מתחיל ב-Gemini. כשהמכסה של ספק נגמרת, הוא עובר לבד לבא בתור, וחוזר אליו כשהמכסה מתפנה.
# שימו לב: בגרסאות החינמיות, הספקים עשויים להשתמש בקלט לאימון. עובדים רק עם נתוני הדוגמה, לא עם נתוני שכר אמיתיים.

# Gemini: מקבלים באתר aistudio.google.com, בכפתור Get API key. בלי כרטיס אשראי.
GEMINI_API_KEY=

# Groq: מקבלים באתר console.groq.com, בתפריט API Keys. בלי כרטיס אשראי.
# שימו לב: בחיבור עם נטפרי, הכתובת api.groq.com חסומה (נבדק). אפשר לבקש מנטפרי לפתוח אותה.
GROQ_API_KEY=

# OpenRouter: מקבלים באתר openrouter.ai, בתפריט Keys. משתמשים רק במודלים חינמיים, אלה שהשם שלהם נגמר ב-:free.
OPENROUTER_API_KEY=

# --- בתשלום ---
# Claude: מקבלים באתר platform.claude.com. משמש רק אם אין מפתחות חינמיים, או אם LLM_PROVIDER=claude.
# ANTHROPIC_API_KEY=

# --- אופציונלי ---
# מי ראשון בתור: gemini, groq או openrouter. או claude כדי לעבוד רק עם Claude.
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
