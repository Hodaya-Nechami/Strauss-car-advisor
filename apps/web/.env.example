# מפתחות API למודלי השפה. העתיקו את הקובץ הזה ל-.env (או ל-.env.local) באותה תיקייה, ומלאו את המפתחות.
# שני הקבצים לא עולים לגיט. לא שולחים מפתחות בצ'אט או במייל.

# --- חינמיים. אפשר אחד או כמה. מפתח אחד לכל ספק. ---
# הבוט עובר לפי הסדר: Gemini, Cohere, Mistral, OpenRouter, Groq.
# כשספק נכשל, למשל כי נגמרה לו המכסה, הבוט עובר לבד לבא בתור, וחוזר אליו אחרי זמן המתנה.
# בגרסאות החינמיות, הספקים עשויים להשתמש בקלט לאימון. עובדים רק עם נתוני הדוגמה, לא עם נתוני שכר אמיתיים.

# Gemini: באתר aistudio.google.com, בכפתור Get API key. בלי כרטיס אשראי. פתוח בנטפרי.
GEMINI_API_KEY=

# Cohere: באתר dashboard.cohere.com, בתפריט API Keys. מפתח Trial חינמי, עד 1,000 קריאות בחודש. פתוח בנטפרי.
COHERE_API_KEY=

# Mistral: באתר console.mistral.ai, בתפריט API Keys, בתוכנית החינמית. פתוח בנטפרי.
MISTRAL_API_KEY=

# OpenRouter: באתר openrouter.ai, בתפריט Keys. הבוט משתמש רק במודלים חינמיים, עד 50 בקשות ביום. פתוח בנטפרי.
OPENROUTER_API_KEY=

# Groq: באתר console.groq.com, בתפריט API Keys. חסום בנטפרי (נבדק). אפשר לבקש מנטפרי לפתוח את api.groq.com.
GROQ_API_KEY=

# קריאת תלוש שכר: Gemini, ואם הוא לא עונה בזמן, OpenRouter (PDF דרך מפענח הטקסט החינמי שלו), ואחריהם OpenAI ו-Claude.
# התלוש לא נשמר אצלנו, אבל הוא נשלח לספק. בגרסה החינמית מעלים רק את התלוש לדוגמה (apps/web/public/samples).

# --- בתשלום ---
# בלי LLM_PROVIDER, הם נכנסים לתור אחרי החינמיים, כגיבוי. כדי שיהיו ראשונים: LLM_PROVIDER=claude,openai
# OpenAI: באתר platform.openai.com, בתפריט API keys.
# OPENAI_API_KEY=
# Claude: באתר platform.claude.com. בלי מפתח אחר, Claude עובד לבד.
# ANTHROPIC_API_KEY=

# מסך הנציג (/rep): סיסמה אחת לכל הצוות. בלי הגדרה, המסך חסום.
# כשמוגדרת התחברות עם גוגל (למטה), הסיסמה לא בשימוש.
REP_PASSWORD=

# --- כניסה עם Google ---
# המערכת פנימית: כשמוגדרים AUTH_SECRET, AUTH_GOOGLE_ID ו-AUTH_GOOGLE_SECRET, כל מסך דורש כניסה עם Google.
# בלי שלושתם הכניסה כבויה, האתר פתוח, ומסך הנציג חוזר לסיסמה (REP_PASSWORD).
# AUTH_GOOGLE_ID ו-AUTH_GOOGLE_SECRET: באתר console.cloud.google.com, APIs & Services, Credentials,
# Create credentials, OAuth client ID, מסוג Web application. ב-Authorized redirect URIs מוסיפים:
#   http://localhost:3000/api/auth/callback/google
#   ובשרת: https://<הכתובת שלכם>/api/auth/callback/google
# ב-OAuth consent screen לוחצים Publish app, אחרת רק משתמשי בדיקה שהוספתם ידנית יוכלו להיכנס.
# AUTH_SECRET: מחרוזת אקראית ארוכה, למשל הפלט של: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REP_EMAILS: המיילים של הנציגים, מופרדים בפסיקים. רק הם נכנסים למסך הנציג.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
REP_EMAILS=
# ALLOWED_EMAILS: מי מהעובדים מורשה להיכנס לאתר: דומיין עם @ או כתובות מלאות, מופרדים בפסיקים.
# ריק: כל חשבון Google (נוח לשופטים). נציגים מ-REP_EMAILS נכנסים תמיד.
# ALLOWED_EMAILS=@strauss-group.com

# --- שליחת האפשרויות למייל (לא חובה) ---
# בלי הגדרה, הכפתור פותח לעובד מייל מוכן בתיבה שלו (Gmail או תוכנת המייל), והוא רק לוחץ "שליחה".
# עם Brevo (חינמי עד 300 ביום) המערכת שולחת בעצמה מייל מעוצב, רק לכתובת של מי שנכנס עם Google:
# brevo.com > Senders > Add a sender (מאמתים את הכתובת), ואז SMTP & API > API Keys > Generate.
# BREVO_API_KEY=
# MAIL_FROM=

# הגבלת קצב (N10): סומכים על כותרת x-forwarded-for רק כשיש פרוקסי אמין מולה (כמו Nginx ב-N9)
# שמחליף כל ערך שהלקוח עצמו שולח. בלי TRUST_PROXY=1 כל הבקשות חולקות מכסה אחת, כדי שלא יהיה
# אפשר לעקוף את ההגבלה בזיוף ה-IP.
# TRUST_PROXY=1

# --- אופציונלי ---
# מי ראשון בתור: gemini, cohere, mistral, openrouter, groq, openai או claude. אפשר כמה, לפי הסדר: claude,openai
# השאר באים אחריהם בסדר הרגיל. claude לבד, בלי פסיק, פירושו לעבוד רק עם Claude, בלי גיבוי.
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# כמה Gemini חושב לפני תשובה: minimal, low, medium או high. ברירת המחדל low מהירה פי כמה.
# GEMINI_THINKING=low
# COHERE_MODEL=command-a-plus-05-2026
# MISTRAL_MODEL=mistral-medium-latest
# אפשר כמה מודלים מופרדים בפסיקים. אם הראשון עמוס, OpenRouter עובר לבא בתור.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-5.5
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# כניסה קבועה במייל וסיסמה (לא חובה), למשל לשופטים שאת המייל שלהם לא יודעים מראש.
# עובדת רק כשהכניסה עם Google מוגדרת. מי שנכנס כך נכנס גם למסך הנציג.
LOGIN_EMAIL=
LOGIN_PASSWORD=
