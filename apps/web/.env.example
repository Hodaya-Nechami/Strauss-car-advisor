# מפתח API למודל השפה. מספיק אחד מהשניים.
# העתיקו את הקובץ הזה ל-.env.local באותה תיקייה, ומלאו את המפתח. את .env.local לא מעלים לגיט.

# Gemini: חינמי, בלי כרטיס אשראי. מקבלים באתר aistudio.google.com, בכפתור Get API key.
# שימו לב: במכסה החינמית גוגל רשאית להשתמש בקלט לאימון. עובדים רק עם נתוני הדוגמה, לא עם נתוני שכר אמיתיים.
GEMINI_API_KEY=

# Claude: בתשלום. מקבלים באתר platform.claude.com.
# ANTHROPIC_API_KEY=

# אופציונלי: איזה מודל להפעיל כשיש את שני המפתחות (gemini או claude), ואיזו גרסה.
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
